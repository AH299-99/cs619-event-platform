{
  "kind": "collectionType",
  "collectionName": "venues",
  "info": { "singularName": "venue", "pluralName": "venues", "displayName": "Venue", "description": "Places where events happen" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true },
    "address": { "type": "string", "required": true },
    "city": { "type": "string", "required": true },
    "region": { "type": "string" },
    "latitude": { "type": "decimal", "required": true },
    "longitude": { "type": "decimal", "required": true },
    "events": { "type": "relation", "relation": "oneToMany", "target": "api::event.event", "mappedBy": "venue" }
  }
}
