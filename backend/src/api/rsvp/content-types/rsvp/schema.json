{
  "kind": "collectionType",
  "collectionName": "rsvps",
  "info": {
    "singularName": "rsvp",
    "pluralName": "rsvps",
    "displayName": "RSVP",
    "description": "User registrations for events"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "status": {
      "type": "enumeration",
      "enum": [
        "going",
        "interested",
        "cancelled"
      ],
      "default": "going",
      "required": true
    },
    "event": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event",
      "inversedBy": "rsvps"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}